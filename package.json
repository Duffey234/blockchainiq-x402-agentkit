{
  "name": "blockchainiq-agentkit",
  "version": "0.1.0",
  "description": "Coinbase AgentKit action provider for the Blockchain IQ x402 crypto data API (market brief and event risk, paid per call in USDC on Base).",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/",
    "typecheck": "tsc -p . --noEmit",
    "probe": "tsc -p . && node dist/examples/probe.js",
    "paid-call": "tsc -p . && node dist/examples/paid-call.js"
  },
  "keywords": [
    "agentkit",
    "coinbase",
    "x402",
    "blockchainiq",
    "usdc",
    "base",
    "crypto-data",
    "action-provider"
  ],
  "dependencies": {
    "@coinbase/agentkit": "0.10.4",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "reflect-metadata": "^0.2.2",
    "viem": "2.38.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.6.0"
  }
}
